# Copy to .env and adjust as needed. Validated at boot by packages/config (fails fast if
# a required variable is missing outside NODE_ENV=test).

NODE_ENV=development

# --- Database -----------------------------------------------------------
# DATABASE_URL is the bootstrap/owner connection, used only by the migrator to create the
# least-privileged ehr_app role and run DDL. The app itself connects as ehr_app via
# APP_DATABASE_URL (see packages/db migration 0001 for why: table owners bypass Postgres
# Row-Level Security, so the app must never connect as the owner).
DATABASE_URL=postgres://ehr_owner:ehr_owner_dev_password@localhost:5432/ehr
APP_DATABASE_URL=postgres://ehr_app:ehr_app_dev_password@localhost:5432/ehr

# --- Cache / locks (Redis-API-compatible; Valkey locally) ---------------
REDIS_URL=redis://localhost:6379

# --- Auth (first-party adapter — see packages/auth-adapter and ADR-0002) -
JWT_ISSUER=ehr-local
JWT_AUDIENCE=ehr-api
# Portal (patient-facing) tokens share the same key material as staff tokens but carry this
# distinct audience, so a staff token can never be replayed on a portal route or vice versa.
PORTAL_JWT_AUDIENCE=ehr-portal
# Auto-generated on first run if absent (dev only) — packages/auth-adapter logs a warning.
# MUST be an absolute path (or otherwise resolve identically) once more than one app reads it —
# apps/api, apps/interop-fhir, and apps/interop-hl7 all verify JWTs with this same key material,
# but each may run with a different working directory (Turborepo/pnpm --filter run tasks from
# each package's own directory), so a relative path silently generates a different keypair per
# app instead of sharing one. Point this at an absolute path, e.g. /home/you/ehr/.dev/jwt-private.pem
# (or C:/ehr/.dev/jwt-private.pem on Windows) for local multi-app dev. Real deployments must
# provision shared key material via AWS Secrets Manager/KMS instead of this auto-generate path.
JWT_PRIVATE_KEY_PATH=./.dev/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./.dev/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Object storage (S3-compatible — MinIO locally, R2 on Railway; see ADR-0001) ---------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ehr-dev-documents
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300

# --- HTTP -----------------------------------------------------------------
PORT=3000
WORKER_PORT=3100
INTEROP_FHIR_PORT=3200
INTEROP_HL7_PORT=3300
WEBHOOK_GATEWAY_PORT=3400

# --- Webhook signing (apps/webhook-gateway's inbound clearinghouse callbacks — spec §12
# "signed webhooks"). A real secret, no default — provision distinctly per environment. Requests
# are verified via HMAC-SHA256 over the raw request body; see packages/db PERMISSION_KEYS docs and
# apps/webhook-gateway/src/common/webhook-signature.ts for the exact scheme.
WEBHOOK_SIGNING_SECRET=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
# Empty = console exporter (no external vendor in dev, per spec rule #10).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ehr-api

# --- Outbox relay -------------------------------------------------------
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50

# --- Bulk FHIR $export relay ---------------------------------------------
BULK_EXPORT_RELAY_POLL_INTERVAL_MS=5000
