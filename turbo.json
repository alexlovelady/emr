{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:authz": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:tenant-isolation": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "migrate:latest": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
