{
  "name": "@ehr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:tenant-isolation": "vitest run --config vitest.tenant-isolation.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@ehr/api-contracts": "workspace:*",
    "@ehr/audit": "workspace:*",
    "@ehr/auth-adapter": "workspace:*",
    "@ehr/authz": "workspace:*",
    "@ehr/config": "workspace:*",
    "@ehr/db": "workspace:*",
    "@ehr/domain-common": "workspace:*",
    "@ehr/documents": "workspace:*",
    "@ehr/intake": "workspace:*",
    "@ehr/object-storage": "workspace:*",
    "@ehr/observability": "workspace:*",
    "@ehr/outbox": "workspace:*",
    "@ehr/patient": "workspace:*",
    "@ehr/scheduling": "workspace:*",
    "@ehr/tasks": "workspace:*",
    "@ehr/tenant": "workspace:*",
    "@ehr/workforce": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "fastify": "4.28.1",
    "kysely": "^0.27.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pg": "^8.13.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
