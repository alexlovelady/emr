.claude/

# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# env / secrets
.env
.env.local
.env.*.local
.dev/
.dev-test/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / OS
.vscode/*
